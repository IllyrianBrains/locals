---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RegionMap from '../components/RegionMap.astro';
import { cities, cityLabel, type City, type CountryCode } from '../data/cities';
const flags: Record<CountryCode, string> = { al: '🇦🇱', xk: '🇽🇰' };
// Cities without a guide yet point at the map, where every city is.
const cityUrl = (city: City) => (city.available ? `/${city.slug}/` : '#qytetet');
// Lead with one city from each country so both are visible above the fold.
const featured = ['tirane', 'prishtine', 'prizren'].map((slug) => cities.find((c) => c.slug === slug)!);
const quick = ['tirane', 'prishtine', 'shkoder', 'prizren', 'berat', 'peje'].map((slug) => cities.find((c) => c.slug === slug)!);
---
<BaseLayout>
  <Header />
  <main>
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy"><p class="eyebrow">Guida vendase · Shqipëri &amp; Kosovë</p><h1>Eja si vizitor.<br /><em>Udhëto si vendas.</em></h1><p>Zbulo qytete, vende të pavarura dhe përvoja që ia vlejnë—pa nxitim.</p><div class="hero-actions"><a class="button primary" href="#qytetet">Gjej qytetin tënd <span>↓</span></a><a class="button hero-secondary" href="#parimet">Udhëto me kujdes <span>↗</span></a></div><p class="trust-note"><span aria-hidden="true">✓</span> Falas, pa regjistrim, shkruar nga vendasit</p></div>
        <aside class="hero-finder" aria-label="Gjej një qytet" data-city-index={JSON.stringify(cities.map((city) => ({ name: city.name, url: cityUrl(city) })))}>
          <p>Ku po shkon?</p>
          <label class="finder-field" for="hero-city-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"></path></svg><input id="hero-city-search" type="search" placeholder="Kërko p.sh. Prizren" autocomplete="off" /></label>
          <div class="quick-links">{quick.map((city) => <a href={cityUrl(city)} data-city-link data-name={city.name.toLowerCase()}><span>{flags[city.country]}</span>{city.name}{city.available && <b>Gati</b>}</a>)}</div>
          <a class="finder-all" href="#qytetet">Shiko të gjitha qytetet <span>→</span></a>
        </aside>
      </div>
    </section>

    <section class="home-strip" aria-label="Çfarë përmban Locals">
      <div class="container home-strip-inner"><span>Ec më shumë</span><i>◆</i><span>Ha lokalisht</span><i>◆</i><span>Natyra</span><i>◆</i><span>Trashëgimia</span><i>◆</i><span>Qëndro më gjatë</span><i>◆</i><span>Respekto vendin</span></div>
    </section>

    <section class="section featured-section">
      <div class="container">
        <header class="section-heading"><div><p class="eyebrow">Qytet pas qyteti</p><h2>Fillo me një qytet</h2></div><p>Shqipëria dhe Kosova, siç i njohin vendasit—guida të shkurtra për të parë më shumë dhe për të mbështetur bizneset vendase.</p></header>
        <div class="featured-grid">{featured.map((city) => { const Tag = city.available ? 'a' : 'article'; return <Tag class:list={['featured-card', { 'is-soon': !city.available }]} href={city.available ? cityUrl(city) : undefined}><img src={city.image} alt="" loading="lazy" referrerpolicy="no-referrer" /><span class="featured-shade"></span>{!city.available && <em>Së shpejti</em>}<span class="featured-content"><small>{cityLabel(city)}</small><strong><i>{flags[city.country]}</i> {city.name}</strong><span class="featured-summary">{city.summary}</span><span class="featured-tags">{city.tags.join(' · ')}</span>{city.available && <span class="featured-cta">Hap guidën →</span>}</span><span class="featured-credit">{city.credit}</span></Tag>; })}</div>
      </div>
    </section>

    <div class="rombi-band" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <section class="section home-map" id="qytetet"><div class="container"><header class="map-heading"><div><p class="eyebrow">Në hartë</p><h2>Gjej qytetin<br /><em>tënd të radhës.</em></h2></div><p>Zgjidh një pikë dhe njih qytetin, ritmin dhe historitë e tij.</p></header><RegionMap /></div></section>

    <section class="section principles" id="parimet"><div class="container principles-grid"><div><p class="eyebrow">Udhëto mirë</p><h2>Më pak nxitim.<br />Më shumë vend.</h2><p>Turizmi i qëndrueshëm fillon me zgjedhje të vogla. Locals i bën ato më të lehta, pa ua hequr spontanitetin udhëtimeve.</p></div><div class="principle-list"><article><span>01</span><div><h3>Lëviz me këmbë, biçikletë ose transport publik</h3><p>Rrugë të realizueshme dhe informacion praktik për të ulur përdorimin e makinës.</p></div></article><article><span>02</span><div><h3>Zgjidh biznese të pavarura</h3><p>Hotele të vogla, restorante familjare, tregje dhe artizanë që mbajnë vlerën brenda komunitetit.</p></div></article><article><span>03</span><div><h3>Respekto ritmin dhe kujtesën e vendit</h3><p>Mëso historinë, pyet para se të fotografosh dhe lëre hapësirën siç e gjete.</p></div></article></div></div></section>
    <section class="contribute"><div class="container"><p class="eyebrow">Nga komuniteti</p><div><h2>Ke një vend të mirë<br />për të ndarë?</h2><a class="button" href="mailto:illyrianbrains@gmail.com?subject=Kontribut për Locals">Na trego <span>↗</span></a></div></div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
.home-hero{position:relative;overflow:hidden;padding:clamp(72px,10vw,130px) 0;color:#fff;background:radial-gradient(circle at 76% 25%,#420c13 0,transparent 31%),var(--forest)}.home-hero:before{position:absolute;inset:0;background-image:linear-gradient(#fff08 1px,transparent 1px),linear-gradient(90deg,#fff08 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(90deg,#000,transparent 72%);content:""}.hero-grid{position:relative;display:grid;grid-template-columns:1.15fr .65fr;gap:clamp(50px,8vw,110px);align-items:center}.hero-copy h1{margin:0;font:400 clamp(58px,8vw,106px)/.86 var(--display);letter-spacing:-.055em}.hero-copy h1 em{color:var(--lime);font-style:italic}.hero-copy>p:not(.eyebrow,.trust-note){max-width:590px;margin:30px 0 0;color:rgba(255,255,255,.65);font-size:17px}.hero-actions{display:flex;align-items:center;gap:12px;margin-top:34px}.primary{color:#fff;background:var(--red);box-shadow:0 0 32px #c61f2c55}.hero-secondary{border:1px solid rgba(255,255,255,.35);color:#fff}.trust-note{display:flex;align-items:center;gap:8px;margin:20px 0 0;color:rgba(255,255,255,.45);font-size:11px}.trust-note span{color:var(--lime)}
.hero-finder{padding:28px;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:rgba(255,255,255,.06);box-shadow:0 30px 70px rgba(0,0,0,.25);backdrop-filter:blur(6px)}.hero-finder>p{margin:0 0 14px;font-size:13px;font-weight:700}.finder-field{display:grid;grid-template-columns:20px 1fr;gap:10px;align-items:center;padding:13px 14px;border-radius:9px;background:#fff}.finder-field svg{width:19px;fill:none;stroke:var(--red);stroke-width:1.8}.finder-field input{min-width:0;border:0;outline:0;color:var(--ink);background:transparent;font:14px var(--sans)}.quick-links{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:14px}.quick-links a{display:flex;align-items:center;gap:8px;padding:9px;border:1px solid rgba(255,255,255,.1);border-radius:7px;color:rgba(255,255,255,.78);font-size:11px;transition:.15s ease}.quick-links a:hover{background:rgba(255,255,255,.09)}.quick-links a[hidden]{display:none}.quick-links span{font-size:17px}.quick-links b{margin-left:auto;padding:2px 6px;border-radius:99px;color:var(--forest);background:var(--lime);font-size:8px;text-transform:uppercase}.finder-all{display:flex;justify-content:space-between;margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.12);font-size:12px;font-weight:700}
.home-strip{overflow:hidden;border-bottom:1px solid var(--line);background:#fff}.home-strip-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-block:18px;color:var(--muted);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;white-space:nowrap}.home-strip i{color:var(--red);font-size:6px;font-style:normal}
.featured-section{background:var(--paper)}.featured-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px}.featured-card{position:relative;display:block;min-height:420px;overflow:hidden;border-radius:16px;color:#fff;background:var(--forest);box-shadow:0 12px 40px #3410170b}.featured-card img,.featured-shade{position:absolute;inset:0;width:100%;height:100%}.featured-card img{object-fit:cover;filter:saturate(.72);transition:transform .45s ease,filter .3s}.featured-shade{background:linear-gradient(transparent 20%,rgba(17,16,16,.92))}a.featured-card:hover img{transform:scale(1.035);filter:saturate(1)}.featured-card>em{position:absolute;top:16px;right:16px;padding:7px 10px;border-radius:99px;color:var(--forest);background:var(--lime);font-size:8px;font-style:normal;font-weight:700;text-transform:uppercase}.featured-content{position:absolute;inset:auto 24px 26px}.featured-content>*{display:block}.featured-content small{color:rgba(255,255,255,.62);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.1em}.featured-content strong{margin-top:7px;font:500 34px/1.05 var(--display)}.featured-content strong i{font-style:normal;font-size:.75em}.featured-summary{max-width:330px;margin-top:8px;color:rgba(255,255,255,.72);font-size:12px}.featured-tags{margin-top:12px;color:var(--lime);font-size:9px;text-transform:uppercase;letter-spacing:.08em}.featured-cta{margin-top:16px;font-size:12px;font-weight:700}.featured-credit{position:absolute;right:10px;top:8px;color:#fff8;font-size:7px}.featured-card.is-soon .featured-credit{top:auto;bottom:6px}
.principles{color:#fff;background:linear-gradient(135deg,#151313,#221114)}.principles-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(60px,10vw,140px)}.principles h2{margin:0;font:400 clamp(48px,6vw,75px)/.94 var(--display)}.principles>div>div:first-child>p:last-child{color:#ffffff91}.principle-list article{display:grid;grid-template-columns:40px 1fr;gap:20px;padding:25px 0;border-top:1px solid #ffffff25}.principle-list article:last-child{border-bottom:1px solid #ffffff25}.principle-list>article>span{color:var(--lime);font-size:9px}.principle-list h3{margin:0;font:400 24px var(--display)}.principle-list p{margin:7px 0 0;color:#ffffff8f;font-size:11px}.contribute{padding:85px 0;color:#fff;background:var(--red)}.contribute .eyebrow{color:var(--forest)}.contribute .container>div{display:flex;align-items:end;justify-content:space-between}.contribute h2{margin:0;font:400 clamp(45px,7vw,76px)/.92 var(--display)}.contribute .button{color:#fff;background:var(--forest)}
.rombi-band{display:flex;justify-content:center;gap:14px;height:86px;overflow:hidden;background:var(--red)}.rombi-band i{flex:0 0 72px;height:72px;margin-top:7px;border:12px double #111;transform:rotate(45deg);opacity:.9}.home-map{position:relative;overflow:hidden;color:#fff;background:#151313}.home-map:before{position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 44px,#ffffff05 45px 46px);content:""}.home-map .container{position:relative}.map-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:42px}.map-heading h2{margin:0;font:400 clamp(48px,6vw,78px)/.92 var(--display);letter-spacing:-.04em}.map-heading h2 em{color:#e4545f;font-style:italic}.map-heading>p{max-width:380px;margin:0;color:#aaa}.home-map :global(.city-map-canvas){height:min(68vh,650px);border-color:#ffffff1c;border-radius:2px;box-shadow:0 0 0 8px #ffffff05}.home-map :global(.city-map-canvas .leaflet-tile-pane){filter:grayscale(1) invert(.88) sepia(.2) hue-rotate(300deg) brightness(.55) contrast(1.35)}.home-map :global(.city-map-legend .key),.home-map :global(.city-map-legend button){color:#eee;background:#211d1d;border-color:#ffffff20}.home-map :global(.map-pin){background:var(--red)}
@media(max-width:850px){.hero-grid,.principles-grid{grid-template-columns:1fr}.hero-finder{max-width:600px}.featured-grid{grid-template-columns:1fr 1fr}.featured-card:first-child{grid-column:1/-1}.contribute .container>div{display:block}.contribute .button{margin-top:30px}}
@media(max-width:720px){.rombi-band{height:58px}.rombi-band i{flex-basis:48px;height:48px;border-width:8px}.map-heading{display:block}.map-heading>p{margin-top:18px}}
@media(max-width:600px){.hero-copy h1{font-size:57px}.hero-actions{flex-direction:column;align-items:stretch}.hero-actions .button{width:100%}.home-strip-inner{justify-content:flex-start;overflow:auto}.featured-grid{grid-template-columns:1fr}.featured-card:first-child{grid-column:auto}.featured-card{min-height:340px}.contribute h2 br{display:none}}
</style>

<script>
  const heroSearch = document.querySelector<HTMLInputElement>('#hero-city-search');
  const quickLinks = [...document.querySelectorAll<HTMLElement>('[data-city-link]')];
  const finder = document.querySelector<HTMLElement>('.hero-finder');
  const cityIndex: { name: string; url: string }[] = JSON.parse(finder?.dataset.cityIndex || '[]');
  heroSearch?.addEventListener('input', () => { const q = heroSearch.value.trim().toLowerCase(); quickLinks.forEach((link) => (link.hidden = !!q && !link.dataset.name?.includes(q))); });
  heroSearch?.addEventListener('keydown', (event) => { if (event.key !== 'Enter') return; const q = heroSearch.value.trim().toLowerCase(); const match = q && cityIndex.find((city) => city.name.toLowerCase().includes(q)); if (match) window.location.href = match.url; else document.querySelector('#qytetet')?.scrollIntoView(); });

</script>
