---
/**
 * Guide page template: one page per city in src/data/cities.ts, built from its OpenStreetMap places, the municipality's
 * sustainable-tourism counts and its Wikidata facts. Tiranë keeps its hand-written page (tirane.astro).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlaceAtlas from '../components/PlaceAtlas.astro';
import CityMap from '../components/CityMap.astro';
import { cities, cityLabel, countries, type City, type CountryCode } from '../data/cities';
import { factLines, getFacts, wikidataUrl } from '../data/cityFacts';
import { getCityPlaces, pillarHints, pillarLabels, type Pillar } from '../data/places';
import municipalities from '../data/municipalities.json';

export function getStaticPaths() {
  return cities.filter((city) => city.slug !== 'tirane').map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const facts = getFacts(city.slug);
const placeCount = getCityPlaces(city.slug)?.count ?? 0;
const counts = municipalities.features.find((f) => f.properties.id === city.osm.boundary)?.properties.pillars as Record<Pillar, number> | undefined;
const nextStops = (Object.keys(countries) as CountryCode[]).map((code) => ({ ...countries[code], cities: cities.filter((c) => c.country === code && c !== city) }));
const heroImage = city.image.replace(/width=\d+/, 'width=2000');
const summary = facts?.summary?.lang === 'sq' ? facts.summary : undefined;
---
<BaseLayout title={`${city.name} · Locals`} description={city.summary}>
  <Header />
  <main class="city-page">
    <section class="city-hero">
      <img class="hero-bg" src={heroImage} alt="" referrerpolicy="no-referrer" />
      <div class="container hero-content">
        <a class="back" href="/#qytetet">← Të gjitha qytetet</a>
        <small>{cityLabel(city)}</small>
        <h1>{city.name}</h1>
        <p>{city.summary}</p>
        <ul class="hero-facts">
          {facts && factLines(facts).map((fact) => <li><b>{fact.value}</b> {fact.label.toLowerCase()}</li>)}
          {placeCount > 0 && <li><b>{placeCount}</b> vende për të parë</li>}
        </ul>
      </div>
      <small class="hero-credit">{city.credit}</small>
    </section>

    {counts && (
      <section class="section offer"><div class="container">
        <h2 class="title">Çfarë ofron</h2>
        <div class="offer-grid">{(Object.keys(pillarLabels) as Pillar[]).map((pillar) => (
          <article><b>{counts[pillar]}</b><h3>{pillarLabels[pillar]}</h3><p>{pillarHints[pillar]}</p></article>
        ))}</div>
        <p class="note">Numërime nga OpenStreetMap për gjithë bashkinë, jo vetëm për qendrën.</p>
      </div></section>
    )}

    <section class="section map-section"><div class="container"><h2 class="title">{city.name} në hartë</h2><CityMap slug={city.slug} /></div></section>

    <section class="section atlas-section"><div class="container"><h2 class="title">Për të parë</h2><PlaceAtlas slug={city.slug} /></div></section>

    <section class="section about"><div class="container about-grid">
      <div>
        <h2 class="title">Rreth {city.name}</h2>
        {summary && <p>{summary.text}</p>}
        <ul class="about-links">
          {summary && <li><a href={summary.source} target="_blank" rel="noreferrer">Wikipedia ↗</a></li>}
          {facts && <li><a href={wikidataUrl(facts)} target="_blank" rel="noreferrer">Wikidata ↗</a></li>}
          {facts?.website && <li><a href={facts.website} target="_blank" rel="noreferrer">Faqja e bashkisë ↗</a></li>}
        </ul>
      </div>
      <aside>
        <h3>Njeh {city.name}?</h3>
        <p>Kjo guidë ndërtohet nga të dhëna të hapura. Na trego një vend, një biznes të vogël ose një shteg që nuk duhet humbur.</p>
        <a class="button" href={`mailto:illyrianbrains@gmail.com?subject=${encodeURIComponent(`Sugjerim për ${city.name}`)}`}>Sugjero një vend <span>↗</span></a>
      </aside>
    </div></section>

    <section class="section next-stops"><div class="container"><h2 class="title">Vazhdo udhëtimin</h2><div class="next-grid">{nextStops.map((country) => <div><h3>{country.name}</h3><ul>{country.cities.map((c) => <li><a href={`/${c.slug}/`}>{c.name} →</a><small>{c.region}</small></li>)}</ul></div>)}</div></div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
.city-hero{position:relative;display:flex;align-items:flex-end;min-height:min(80vh,720px);overflow:hidden;color:#fff;background:var(--forest)}.hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.city-hero:after{position:absolute;inset:0;background:linear-gradient(180deg,#0000 25%,#000b 100%),linear-gradient(90deg,#0008,#0000 65%);content:''}.hero-content{position:relative;z-index:1;padding:40px 0 clamp(40px,6vw,72px)}.back{display:inline-block;margin-bottom:20px;color:#ffffffcc;font-size:13px}.back:hover{color:#fff}.hero-content>small{display:block;color:#ffffffb0;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.city-hero h1{margin:6px 0 0;font:400 clamp(64px,12vw,160px)/.9 var(--display);letter-spacing:-.05em;text-shadow:0 4px 30px #0005}.hero-content>p{max-width:560px;margin:18px 0 0;font:400 clamp(19px,2vw,24px)/1.35 var(--display);text-shadow:0 2px 12px #0008}.hero-facts{display:flex;flex-wrap:wrap;gap:8px;margin:26px 0 0;padding:0;list-style:none}.hero-facts li{padding:9px 15px;border:1px solid #ffffff40;border-radius:99px;background:#0003;backdrop-filter:blur(8px);font-size:13px}.hero-facts b{margin-right:5px}.hero-credit{position:absolute;right:14px;bottom:10px;z-index:1;color:#ffffffa0;font-size:9px}
.title{margin:0 0 32px;font:400 clamp(40px,5.5vw,64px)/1 var(--display);letter-spacing:-.03em}
.offer{background:var(--cream)}.offer-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.offer-grid article{padding:24px;border-radius:16px;background:var(--paper);border:1px solid var(--line)}.offer-grid b{display:block;color:var(--leaf);font:400 48px/1 var(--display)}.offer-grid h3{margin:14px 0 6px;font:500 20px/1.15 var(--display)}.offer-grid p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.note{margin:18px 0 0;color:var(--muted);font-size:12px}
.map-section{padding-bottom:clamp(40px,5vw,64px)}.atlas-section{background:var(--cream)}
.about-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(40px,7vw,100px);align-items:start}.about-grid p{max-width:620px;margin:0;font:400 20px/1.5 var(--display)}.about-links{display:flex;flex-wrap:wrap;gap:8px 20px;margin:24px 0 0;padding:0;list-style:none}.about-links a{color:var(--leaf);font-size:13px;font-weight:700}.about aside{padding:28px;border-radius:16px;background:var(--lime)}.about aside h3{margin:0;font:400 30px/1.1 var(--display)}.about aside p{margin:10px 0 0;font:400 16px/1.5 var(--sans)}.about aside .button{margin-top:20px;color:#fff;background:var(--forest)}
.next-stops{border-top:1px solid var(--line)}.next-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.next-grid h3{margin:0 0 12px;font:500 28px var(--display)}.next-grid ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.next-grid li{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:14px 0;border-bottom:1px solid var(--line);font-size:15px}.next-grid li a{color:var(--clay);font-weight:600}.next-grid small{color:var(--muted);font-size:11px}
@media(max-width:980px){.offer-grid{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:800px){.about-grid{grid-template-columns:1fr}}
@media(max-width:720px){.next-grid{grid-template-columns:1fr}.offer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.city-hero{min-height:min(74vh,600px)}.offer-grid{grid-template-columns:1fr}}
</style>
