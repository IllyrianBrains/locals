---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlaceAtlas from '../components/PlaceAtlas.astro';
import CityMap, { type FeaturedPin } from '../components/CityMap.astro';
import { cities, countries, type CountryCode } from '../data/cities';
import { getCityPlaces } from '../data/places';
import { getOutdoors, levelLabels } from '../data/outdoors';

const city = cities.find((c) => c.slug === 'tirane')!;
const nextStops = (Object.keys(countries) as CountryCode[]).map((code) => ({ ...countries[code], cities: cities.filter((c) => c.country === code && c !== city) }));

const osmPlaces = getCityPlaces('tirane')?.places ?? [];
const osm = (name: string) => {
  const place = osmPlaces.find((p) => p.name === name);
  if (!place) throw new Error(`OSM place not found: ${name}`);
  return place;
};
const gmaps = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;

const essentials = [
  { icon: '↗', title: 'Nga aeroporti', text: 'Autobusi lidhet me qendrën për rreth 30–40 minuta.' },
  { icon: '◌', title: 'Në këmbë', text: 'Qendra është kompakte; shumica e ndalesave janë 10–20 minuta larg njëra-tjetrës.' },
  { icon: 'L', title: 'Pagesat', text: 'Leku (ALL). Kartat pranohen gjerësisht, por mbaj cash për tregjet.' },
  { icon: '112', title: 'Emergjenca', text: 'Numri i unifikuar. Uji i rubinetit nuk rekomandohet për pirje.' },
];

const places = [
  { title: 'Sheshi Skënderbej', type: 'Histori · Hapësirë publike', text: 'Fillo këtu për të kuptuar shtresat e qytetit dhe për të vizituar Xhaminë e Et’hem Beut.', image: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Skanderbeg%20square%2C%20Tiran%C3%AB%2C%20Albania%20.jpg?width=1000', credit: 'Meriboo · CC BY-SA 3.0', osm: osm('Monumenti i Skënderbeut') },
  { title: 'Pazari i Ri', type: 'Treg · Ushqim lokal', text: 'Produkte të stinës, mëngjes dhe biznese të vogla vendase.', image: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/The%20New%20Bazaar%20of%20Tirana.jpg?width=1000', credit: 'Besara1 · CC BY-SA 4.0', osm: osm('Pazari i Ri') },
  { title: 'Piramida', type: 'Arkitekturë · Kulturë', text: 'Një prej ndërtesave më të debatueshme të qytetit, sot hapësirë publike që mund ta ngjitësh.', image: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Pyramid%20of%20Tirana%20October%202023.jpg?width=1000', credit: 'BBB2021 · CC BY-SA 4.0', osm: osm('Piramida e Tiranës') },
  { title: 'Parku i Madh', type: 'Natyrë · Ecje', text: 'Pushim i gjelbër larg ritmit të qendrës, me shteg rreth liqenit.', image: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Artificial%20Lake%2C%20Tirana%20Park%2C%20Albania.jpg?width=1000', credit: 'DenisaRucaj · CC BY-SA 4.0', osm: osm('Parku i Madh i Tiranës') },
];

const secrets = [
  { title: 'Ura e Tabakëve', text: 'Urë guri e shekullit XVIII, dikur pjesë e rrugës së karvanëve nga malësitë lindore.', osm: osm('Ura e Tabakëve') },
  { title: 'Mozaiku i Tiranës', text: 'Gjurmët e një vile romake dhe mozaikët e saj, mes lagjeve të qytetit modern.', osm: osm('Mozaiku i Tiranës') },
  { title: 'Tyrbja e Kapllan Pashës', text: 'Tetë kolona guri nga viti 1817, një monument që humbet lehtë mes ndërtesave.', osm: osm('Tyrbja e Kapllan Pashës') },
];

const number = (n: number) => String(n).padStart(2, '0');
const featured: FeaturedPin[] = [
  ...places.map((p, i) => ({ number: number(i + 1), place: p.osm, tone: 'stop' as const })),
  ...secrets.map((s, i) => ({ number: number(places.length + i + 1), place: s.osm, tone: 'secret' as const })),
];
const featuredIds = featured.map((f) => f.place.id);
const outdoors = getOutdoors('tirane');

const itinerary = [
  { time: '09:00', title: 'Qendra pa nxitim', text: 'Kafe pranë sheshit, Xhamia e Et’hem Beut dhe muzeu që të tërheq më shumë.' },
  { time: '12:30', title: 'Drekë te Pazari i Ri', text: 'Zgjidh një restorant të pavarur dhe provo një pjatë sezonale.' },
  { time: '15:00', title: 'Nga Piramida te Liqeni', text: 'Ec përgjatë bulevardit dhe vazhdo drejt Parkut të Madh.' },
  { time: '19:00', title: 'Mbrëmje në lagje', text: 'Kthehu përmes Bllokut dhe gjej një lokal larg rrugëve të zhurmshme.' },
];
---
<BaseLayout title="Tirana · Locals" description="Një guidë lokale dhe e qëndrueshme për të zbuluar Tiranën në këmbë, me kulturë, natyrë dhe biznese vendase.">
  <Header />
  <main class="city-page">
    <section class="city-hero">
      <img class="hero-bg" src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Panorama%20view%20of%20Tirana%20square%20-%202.jpeg?width=2400" alt="Sheshi Skënderbej me Xhaminë e Et’hem Beut dhe Kullën e Sahatit" referrerpolicy="no-referrer" />
      <div class="container hero-content">
        <a class="back" href="/#qytetet">← Të gjitha qytetet</a>
        <h1>Tirana</h1>
        <p>Kryeqyteti plot ngjyra i Shqipërisë—kafe në çdo qoshe, histori në çdo shesh dhe male në horizont.</p>
        <ul class="hero-facts"><li><b>2–3</b> ditë ideale</li><li><b>{featured.length}</b> ndalesa në hartë</li><li><b>{outdoors.length}</b> dalje në natyrë</li><li><b>✓</b> gjithçka në këmbë</li></ul>
      </div>
      <small class="hero-credit">Leeturtle · CC BY-SA 3.0</small>
    </section>
    <nav class="city-nav" aria-label="Seksionet"><div class="container"><a href="#harta">Harta</a><a href="#shiko">Mos i humb</a><a href="#natyra">Natyra</a><a href="#atlas">Më shumë</a><a href="#dita">Një ditë</a><a href="#kujdes">Këshilla</a></div></nav>

    <section class="essentials" aria-label="Para se të nisesh"><div class="container essential-grid">{essentials.map((item) => <article><i>{item.icon}</i><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>

    <section class="section map-section" id="harta"><div class="container"><h2 class="title">Tirana në hartë</h2><CityMap slug="tirane" featured={featured} /></div></section>

    <section class="section highlights" id="shiko"><div class="container">
      <h2 class="title">Mos i humb</h2>
      <div class="place-grid">{places.map((place, index) => (
        <a class="place-card" href={gmaps(`${place.osm.name} Tirana`)} target="_blank" rel="noreferrer">
          <figure><img src={place.image} alt={place.title} loading="lazy" referrerpolicy="no-referrer" /><em>{index + 1}</em><b>↗</b><figcaption><span>{place.type}</span><h3>{place.title}</h3></figcaption><small>{place.credit}</small></figure>
          <p>{place.text}</p>
        </a>
      ))}</div>
      <div class="secret-panel"><h3>Sekretet e qytetit</h3>{secrets.map((secret, index) => <article><em>{places.length + index + 1}</em><h4>{secret.title}</h4><p>{secret.text}</p><a href={gmaps(`${secret.osm.name} Tirana`)} target="_blank" rel="noreferrer">Drejtimet ↗</a></article>)}</div>
    </div></section>

    {outdoors.length > 0 && (
      <section class="section nature" id="natyra"><div class="container">
        <figure class="nature-photo"><img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/Tirana%20from%20Dajt.jpg?width=1800" alt="Teleferiku i Dajtit mbi Tiranë" loading="lazy" referrerpolicy="no-referrer" /><h2>Dil në natyrë</h2><figcaption>Tobias Michaelsen · CC BY 2.0</figcaption></figure>
        <div class="trail-grid">{outdoors.map((trail) => (
          <article>
            <div class="trail-kinds">{trail.kinds.map((k) => <span>{k}</span>)}</div>
            <h3>{trail.title}</h3>
            <p>{trail.text}</p>
            <dl>
              {trail.distance && <div><dt>Gjatësia</dt><dd>{trail.distance}</dd></div>}
              {trail.duration && <div><dt>Koha</dt><dd>{trail.duration}</dd></div>}
              <div><dt>Niveli</dt><dd><i class="level" data-level={trail.level} aria-hidden="true"><b></b><b></b><b></b></i>{levelLabels[trail.level]}</dd></div>
              <div><dt>Si shkohet</dt><dd>{trail.access}</dd></div>
            </dl>
            <a href={gmaps(trail.map)} target="_blank" rel="noreferrer">Hape në hartë ↗</a>
          </article>
        ))}</div>
      </div></section>
    )}

    <section class="section atlas-section" id="atlas"><div class="container"><h2 class="title">Më shumë për të parë</h2><PlaceAtlas slug="tirane" exclude={featuredIds} /></div></section>

    <section class="section day" id="dita"><div class="container"><h2 class="title">Një ditë në Tiranë</h2><ol class="timeline">{itinerary.map((stop) => <li><time>{stop.time}</time><h3>{stop.title}</h3><p>{stop.text}</p></li>)}</ol></div></section>

    <section class="section care" id="kujdes"><div class="container care-grid"><h2>Udhëto si një vendas.</h2><div><p>Mbush shishen përsëri, ec ose merr autobusin, dhe bli te bizneset e vogla vendase.</p><a class="button" href="mailto:illyrianbrains@gmail.com?subject=Sugjerim për guidën e Tiranës">Sugjero një vend <span>↗</span></a></div></div></section>

    <section class="section next-stops"><div class="container"><h2 class="title">Vazhdo udhëtimin</h2><div class="next-grid">{nextStops.map(country => <div><h3>{country.name}</h3><ul>{country.cities.map(c => <li>{c.available ? <a href={`/${c.slug}/`}>{c.name} →</a> : <span>{c.name}</span>}<small>{c.available ? c.region : 'Së shpejti'}</small></li>)}</ul></div>)}</div></div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
.city-hero{position:relative;display:flex;align-items:flex-end;min-height:min(86vh,820px);overflow:hidden;color:#fff;background:var(--forest)}.hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.city-hero:after{position:absolute;inset:0;background:linear-gradient(180deg,#0000 25%,#000b 100%),linear-gradient(90deg,#0008,#0000 65%);content:''}.hero-content{position:relative;z-index:1;padding:40px 0 clamp(40px,6vw,72px)}.back{display:inline-block;margin-bottom:20px;color:#ffffffcc;font-size:13px}.back:hover{color:#fff}.city-hero h1{margin:0;font:400 clamp(80px,14vw,190px)/.85 var(--display);letter-spacing:-.05em;text-shadow:0 4px 30px #0005}.hero-content>p{max-width:560px;margin:18px 0 0;font:400 clamp(19px,2vw,24px)/1.35 var(--display);text-shadow:0 2px 12px #0008}.hero-facts{display:flex;flex-wrap:wrap;gap:8px;margin:26px 0 0;padding:0;list-style:none}.hero-facts li{padding:9px 15px;border:1px solid #ffffff40;border-radius:99px;background:#0003;backdrop-filter:blur(8px);font-size:13px}.hero-facts b{margin-right:5px}.hero-credit{position:absolute;right:14px;bottom:10px;z-index:1;color:#ffffffa0;font-size:9px}
.city-nav{position:sticky;top:88px;z-index:40;border-bottom:1px solid var(--line);background:#fffffff2;backdrop-filter:blur(12px)}.city-nav .container{display:flex;gap:6px;overflow-x:auto;padding:10px 0;scrollbar-width:none}.city-nav a{flex:none;padding:8px 15px;border-radius:99px;color:var(--ink);font-size:13px;font-weight:600;transition:background .2s}.city-nav a:hover{background:var(--cream)}

.title{margin:0 0 32px;font:400 clamp(40px,5.5vw,64px)/1 var(--display);letter-spacing:-.03em}

.essentials{border-bottom:1px solid var(--line);background:var(--cream)}.essential-grid{display:grid;grid-template-columns:repeat(4,1fr)}.essential-grid article{display:flex;gap:14px;padding:26px 22px;border-right:1px solid var(--line)}.essential-grid article:first-child{padding-left:0}.essential-grid article:last-child{border-right:0}.essential-grid i{display:grid;flex:none;place-items:center;width:40px;height:40px;border:1px solid var(--line);border-radius:50%;color:var(--leaf);background:var(--paper);font-size:12px;font-style:normal;font-weight:700}.essential-grid h3{margin:0;font:500 18px var(--display)}.essential-grid p{margin:4px 0 0;color:var(--muted);font-size:13px;line-height:1.5}

.map-section{padding-bottom:clamp(40px,5vw,64px)}.highlights{padding-top:clamp(40px,5vw,64px)}

.place-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.place-card figure{position:relative;aspect-ratio:3/4;margin:0;overflow:hidden;border-radius:16px;background:var(--line)}.place-card img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.place-card:hover img{transform:scale(1.05)}.place-card figure:after{position:absolute;inset:0;background:linear-gradient(180deg,#0000 45%,#000c);content:''}.place-card em{position:absolute;top:14px;left:14px;z-index:1;display:grid;place-items:center;width:32px;height:32px;border:2px solid #fff;border-radius:50%;color:#fff;background:var(--forest);font:700 13px var(--sans)}.place-card figure>b{position:absolute;top:14px;right:14px;z-index:1;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;color:var(--forest);background:#fff;opacity:0;transition:opacity .3s}.place-card:hover figure>b{opacity:1}.place-card figcaption{position:absolute;right:18px;bottom:22px;left:18px;z-index:1;color:#fff}.place-card figcaption span{font-size:11px;font-weight:600;opacity:.85}.place-card h3{margin:2px 0 0;font:500 clamp(24px,2.3vw,30px)/1.05 var(--display)}.place-card small{position:absolute;right:10px;bottom:6px;z-index:1;color:#fff9;font-size:8px}.place-card p{margin:12px 2px 0;color:var(--muted);font-size:14px;line-height:1.55}
.secret-panel{display:grid;grid-template-columns:1fr repeat(3,1.1fr);gap:30px;margin-top:56px;padding:clamp(28px,4vw,44px);border-radius:18px;color:#fff;background:#16171b}.secret-panel>h3{margin:0;font:400 clamp(30px,3.4vw,40px)/1 var(--display)}.secret-panel article{padding-left:20px;border-left:1px solid #ffffff24}.secret-panel em{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;color:var(--forest);background:var(--lime);font:700 12px var(--sans)}.secret-panel h4{margin:14px 0 6px;font:500 21px/1.15 var(--display)}.secret-panel p{margin:0 0 10px;color:#ffffffa8;font-size:13px;line-height:1.55}.secret-panel a{color:var(--lime);font-size:12px;font-weight:700}

.nature{padding-top:0;color:#fff;background:var(--forest)}.nature-photo{position:relative;display:flex;align-items:flex-end;height:clamp(300px,42vw,500px);margin:0 calc(50% - 50vw) 24px;overflow:hidden}.nature-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.nature-photo:after{position:absolute;inset:0;background:linear-gradient(180deg,#0000 40%,var(--forest));content:''}.nature-photo h2{position:relative;z-index:1;width:min(1180px,calc(100% - 40px));margin:0 auto 10px;font:400 clamp(48px,7vw,88px)/1 var(--display);letter-spacing:-.03em;text-shadow:0 4px 24px #0006}.nature-photo figcaption{position:absolute;top:10px;right:14px;z-index:1;color:#ffffffa0;font-size:9px}
.trail-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}.trail-grid article{display:flex;flex-direction:column;padding:24px;border:1px solid #ffffff24;border-radius:16px;background:#ffffff0a}.trail-kinds{display:flex;flex-wrap:wrap;gap:6px}.trail-kinds span{padding:3px 10px;border-radius:99px;color:var(--forest);background:var(--lime);font-size:11px;font-weight:700}.trail-grid h3{margin:16px 0 6px;font:500 24px/1.1 var(--display)}.trail-grid article>p{margin:0;color:#ffffffb0;font-size:14px;line-height:1.55}.trail-grid dl{display:grid;gap:8px;margin:18px 0;padding-top:16px;border-top:1px solid #ffffff24}.trail-grid dl div{display:grid;grid-template-columns:82px 1fr;gap:10px;font-size:13px}.trail-grid dt{color:#ffffff88}.trail-grid dd{display:flex;align-items:center;gap:8px;margin:0}.level{display:inline-flex;gap:3px}.level b{width:7px;height:7px;border:1px solid var(--lime);border-radius:50%}.level[data-level="1"] b:nth-child(-n+1),.level[data-level="2"] b:nth-child(-n+2),.level[data-level="3"] b{background:var(--lime)}.trail-grid article>a{margin-top:auto;color:var(--lime);font-size:13px;font-weight:700}

.atlas-section{background:var(--cream)}

.timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin:0;padding:0;list-style:none}.timeline li{position:relative;padding-top:26px;border-top:1px solid var(--line)}.timeline li:before{position:absolute;top:-5px;left:0;width:9px;height:9px;border-radius:50%;background:var(--leaf);content:''}.timeline time{color:var(--clay);font-size:13px;font-weight:700}.timeline h3{margin:6px 0;font:500 24px/1.15 var(--display)}.timeline p{margin:0;color:var(--muted);font-size:14px;line-height:1.55}

.care{padding:clamp(56px,7vw,90px) 0;background:var(--lime)}.care-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.care h2{margin:0;font:400 clamp(40px,5.5vw,64px)/.95 var(--display)}.care-grid p{margin:0;font:400 20px/1.5 var(--display)}.care .button{margin-top:18px;color:#fff;background:var(--forest)}

.next-stops{border-top:1px solid var(--line)}.next-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.next-grid h3{margin:0 0 12px;font:500 28px var(--display)}.next-grid ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.next-grid li{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:14px 0;border-bottom:1px solid var(--line);font-size:15px}.next-grid li a{color:var(--clay);font-weight:600}.next-grid small{color:var(--muted);font-size:11px}

@media(max-width:980px){.place-grid{grid-template-columns:1fr 1fr}.secret-panel{grid-template-columns:1fr 1fr 1fr}.secret-panel>h3{grid-column:1/-1}.essential-grid{grid-template-columns:1fr 1fr}.essential-grid article:nth-child(2){border-right:0}.essential-grid article:nth-child(3){padding-left:0}.essential-grid article:nth-child(-n+2){border-bottom:1px solid var(--line)}.timeline{grid-template-columns:1fr 1fr;row-gap:34px}}
@media(max-width:800px){.care-grid{grid-template-columns:1fr;gap:20px}.secret-panel{grid-template-columns:1fr}.secret-panel article{padding:18px 0 0;border-top:1px solid #ffffff24;border-left:0}}
@media(max-width:900px){.city-nav{top:76px}}
@media(max-width:720px){.next-grid{grid-template-columns:1fr}}
@media(max-width:600px){.city-nav{top:72px}}
@media(max-width:560px){.city-hero{min-height:min(80vh,640px)}.hero-bg{object-position:58% center}.essential-grid{grid-template-columns:1fr}.essential-grid article{padding:16px 0;border-right:0;border-bottom:1px solid var(--line)}.essential-grid article:last-child{border-bottom:0}.place-grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:78%;overflow-x:auto;margin:0 -14px;padding:0 14px;scroll-snap-type:x mandatory;scrollbar-width:none}.place-card{scroll-snap-align:start}.timeline{grid-template-columns:1fr}}
</style>
