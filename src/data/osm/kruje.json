    {
      "id": "way/226793335",
      "name": "Xhamia e Pazarit",
      "nameEn": "Bazaar Mosque",
      "category": "religion",
      "kind": "place_of_worship",
      "lat": 41.509666,
      "lon": 19.794561,
      "wikidata": "Q809778",
      "wikipedia": "sq:Xhamia e Pazarit, Krujë",
      "osmUrl": "https://www.openstreetmap.org/way/226793335",
      "score": 10,
      "imageFile": "A mosque in Krujë.JPG",
      "image": "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/A_mosque_in_Kruj%C3%AB.JPG/1280px-A_mosque_in_Kruj%C3%AB.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
      "imageCredit": "Avi1111 dr. avishai teicher · CC BY-SA 4.0",
      "tagline": {
        "text": "xhami",
        "lang": "sq"
      },
      "summary": {
        "text": "Xhamia e Pazarit ose Xhamia Muratbeu, i njohur edhe si Xhamia e Varoshit, është një xhami në qytetin e Krujës, Shqipëria, që daton në epokën otomane dhe është konsideruar madhështore. Xhamia e Pazarit është një nga shumë \"monument kulture\" (Monumentet Kulturore Shqiptare) të Shqipërisë dhe është konsideruar si një nga xhamitë e pakta të mbetura që kanë mbijetuar periudhën komuniste 1945-1990.",
        "lang": "sq",
        "source": "https://sq.wikipedia.org/wiki/Xhamia_e_Pazarit%2C_Kruj%C3%AB"
      }
    },
