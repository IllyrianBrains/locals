    {
      "id": "way/198486922",
      "name": "Deshmoret e 2 Prillit",
      "category": "history",
      "kind": "memorial",
      "lat": 42.066257,
      "lon": 19.510531,
      "description": "Dëshmorët e Demokracisë",
      "wikipedia": "sq:Dëshmorët e Demokracisë",
      "heritage": "yes",
      "osmUrl": "https://www.openstreetmap.org/way/198486922",
      "score": 7,
      "summary": {
        "text": "Protestat kundër regjimit diktatorial të komunistëve enveristë në 2 prill të vitit 1991, i morën jetën katër të rinjve studentë në qendër të Shkodrës. Shpallja e protestave në të gjithë Shqipërinë, arriti pikën kulmore në kryeqendrën e veriut, nga ku u demonstrua hapur qëndresa e studentëve dhe popullsisë vendase, për te rrëzuar regjimin.",
        "lang": "sq",
        "source": "https://sq.wikipedia.org/wiki/D%C3%ABshmor%C3%ABt_e_Demokracis%C3%AB"
      }
    },
    {
      "id": "node/3961574347",
      "name": "Heronjtë e Vigut",
      "category": "history",
      "kind": "memorial",
      "lat": 42.089279,
      "lon": 19.507404,
      "wikidata": "Q9034995",
      "wikipedia": "sq:5 Heronjtë e Vigut",
      "osmUrl": "https://www.openstreetmap.org/node/3961574347",
      "score": 7,
      "imageFile": "5 Heronjte e Vigut - Shkoder.jpg",
      "image": "https://upload.wikimedia.org/wikipedia/commons/2/22/5_Heronjte_e_Vigut_-_Shkoder.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled",
      "imageCredit": "user:Leke Mjeku · Public domain",
      "tagline": {
        "text": "monument kulturor",
        "lang": "sq"
      },
      "summary": {
        "text": "Monumenti i \"5 Heronjve të Vigut\" në kujtim të heronjve të popullit Ahmet Haxhia, Naim Gjylbegu, Ndoc Mazi, Hydajet Lezha dhe Ndoc Deda, me një bazament të lartë rreth katër metra dhe figura rreth gjashtë metra i larë në bronz, qëndroi për vite në një nga sheshet e qendrës së qytetit të Shkodrës, i rrethuar nga ndërtesat e Radio Shkodrës, Teatrit \"Migjeni\" dhe Hotel Turizmit \"Rozafa\". Pasi u besua se ishin komunistë dhe/ose terroristë, monumenti u zhvendos tek \"Varrezat e Dëshmorëve\" të Shkodrës.",
        "lang": "sq",
        "source": "https://sq.wikipedia.org/wiki/5_Heronjt%C3%AB_e_Vigut"
      }
    },
    {
      "id": "way/323844814",
      "name": "Monument Kulture - Familja Çeka",
      "category": "attraction",
      "kind": "attraction",
      "lat": 42.063455,
      "lon": 19.51671,
      "description": "Në këtë shtëpi ka lindur dhe jetuar atdhetari Filip Pjetër Çeka. Ndër anëtarët më aktivë të degës së lidhjes shqiptare për Shkodren. 1878-1880",
      "wikipedia": "sq:Çekajt",
      "openingHours": "Mo-Fr 09:00-18:00",
      "wheelchair": "limited",
      "osmUrl": "https://www.openstreetmap.org/way/323844814",
      "score": 7,
      "summary": {
        "text": "Një nga nga familjet më të vjetra të qytetit të Shkodrës, ku të parët e saj kanë qenë pronarë të mëdhenj tokash dhe më pas janë marrë me tregti, ekonomi e politikë, është dhe familja Çeka. Në një nga dhomat e banesës karakteristike shkodrane, e cila ndodhet në qendër të qytetit në lagjen \"Ndoc Mazi\", Ëngjëlli dhe familja e tij kanë ekspozuar figurat kryesore të familjes, dokumentet e fotot kryesore të figurave të saj.",
        "lang": "sq",
        "source": "https://sq.wikipedia.org/wiki/%C3%87ekajt"
      }
    },
    {
      "id": "way/324735622",
      "name": "Hamami i Shkodrës",
      "category": "history",
      "kind": "attraction",
      "lat": 42.061621,
      "lon": 19.506513,
      "description": "Historical Public Shower - Hamam",
      "wikipedia": "sq:Shkodra",
      "fee": "yes",
      "wheelchair": "limited",
      "osmUrl": "https://www.openstreetmap.org/way/324735622",
      "score": 6,
      "summary": {
        "text": "Shkodra është qytet dhe bashki në Shqipërinë Veriperëndimore, si dhe qendra e rrethit dhe e qarkut Shkodër. Është një nga qytetet më të vjetra të Shqipërisë me një histori banimi mijëvjeçare në qytet dhe krahinë.",
        "lang": "sq",
        "source": "https://sq.wikipedia.org/wiki/Shkodra"
      }
