    {
      "id": "way/460202585",
      "name": "Xhamia Medresesë '' Atik Xhamia''",
      "nameEn": "Mosque of Madrasah",
      "category": "religion",
      "kind": "place_of_worship",
      "lat": 42.467784,
      "lon": 21.467761,
      "description": "Atik Mosque, otherwise known as Madrasah Mosque, was built in the 17th century. It is the first mosque built in the city. The notes speak of the completion of the works in 1606, but there are also writings that speak of the year 1609.",
      "wikidata": "Q25572431",
      "wikipedia": "sq:Xhamia Atik",
      "imageFile": "Xhamia Atik.jpg",
      "osmUrl": "https://www.openstreetmap.org/way/460202585",
      "score": 11,
      "image": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/89/Xhamia_Atik.jpg/1280px-Xhamia_Atik.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
      "imageCredit": "IsmailGagica · CC BY-SA 4.0",
      "tagline": {
        "text": "xhami",
        "lang": "sq"
      },
      "summary": {
        "text": "Xhamia Atik e njohur edhe si Xhamia e Medresesë është një monument i trashëgimisë kulturore në Gjilan, Kosovë. Është xhamia e parë e ndërtuar në qytet, në shekullin e XVII, dhe që mendohet të ketë përfunduar ndërtimi në vitet 1606-1609.Atik xhamia eshte ndertuar me materiale te ndryshme: gure, tulla, hatulla vertikale dhe horizontale, llaq gelqereje dhe thupra te shtypurua.",
        "lang": "sq",
        "source": "https://sq.wikipedia.org/wiki/Xhamia_Atik"
      }
    },
