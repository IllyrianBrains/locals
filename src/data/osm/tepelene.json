    {
      "id": "way/1487950243",
      "name": "Kampi i Tepelenës  (1949–1954)",
      "nameEn": "Tepelenë internment camp (1949–1954)",
      "category": "museum",
      "kind": "museum",
      "lat": 40.300723,
      "lon": 20.015555,
      "description": "The Tepelenë Internment Camp was a brutal site for families of \"enemies of the state.\" In the inhumane conditions of former barracks, hundreds of children and elderly died from starvation and disease. Prisoners performed slave labor in mined areas.",
      "wikidata": "Q65309136",
      "wikipedia": "en:Tepelenë Internment Camp",
      "website": "https://akt.gov.al/en/attractions/Tepelene-camp-memorial-museum/",
      "osmUrl": "https://www.openstreetmap.org/way/1487950243",
      "score": 14,
      "imageFile": "Kampi i Tepelenes 001.jpg",
      "image": "https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Kampi_i_Tepelenes_001.jpg/1280px-Kampi_i_Tepelenes_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
      "imageCredit": "Arianit · CC BY-SA 4.0",
      "tagline": {
        "text": "Albanian internment camp",
        "lang": "en"
      },
      "summary": {
        "text": "Kampi i Internimit i Tepelenës apo Kampi i Tepelenës ka qenë një strukturë internimi në përngjasim me kolkozet sovjetike pranë kalasë së qytetit të Tepelenës, në Republikën Popullore të Shqipërisë, ku u mbajtën familjarët e të dënuarve, arratisurve dhe ushtarakëve dezertorë. U mbajtën dhe një numër i madh fëmijësh dhe nga kushtet pati një vdekshmëri të lartë foshnjore.",
        "lang": "sq",
        "source": "https://sq.wikipedia.org/wiki/Kampi_i_Tepelen%C3%ABs"
      }
    },
