---
import '../styles/global.css';
const { title = 'Locals · Udhëto si vendas në Shqipëri dhe Kosovë', description = 'Vende të fshehta, këshilla lokale dhe mënyra të thjeshta për të mbështetur komunitetet e Shqipërisë dhe Kosovës.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="sq">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#191a1f" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/fv.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Illyrian Brains Network" />
    <meta property="og:image" content={new URL('/assets/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/assets/og-image.png', Astro.site)} />
    <meta property="og:locale" content="sq_AL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body><slot /></body>
</html>
