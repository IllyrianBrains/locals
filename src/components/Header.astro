---
const isHome = Astro.url.pathname === '/';
---
<header class="site-header">
  <div class="brand">
    <a class="brand-main" href="https://illyrianbrains.org/" aria-label="Shko te Illyrian Brains">
      <img src="/assets/logo.png" alt="Illyrian Brains network" />
    </a>
    <a class="brand-project" href="/" aria-label="Shko te ballina e Locals">Locals</a>
  </div>
  <button class="nav-toggle" type="button" aria-label="Hap menynë" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span></button>
  <nav class="site-nav" id="site-nav" aria-label="Navigimi kryesor">
    <a href="/" aria-current={isHome ? 'page' : undefined}>Ballina</a>
    <a href="/#udhetimet">Llojet e udhëtimeve</a>
    <a href="/#udhetimet">Katalogu i qyteteve</a>
    <a class="nav-cta" href="/kontribuo/">Kontribuo</a>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('.site-nav');
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); });
</script>
